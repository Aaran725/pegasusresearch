# Server-side only (loaded by server/index.js via dotenv). No VITE_ prefix,
# so these can never be inlined into the client bundle by Vite.

# Groq (https://console.groq.com/keys). Up to 3 keys are rotated on failure.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Tavily (https://tavily.com) — free tier: 1,000 search credits/month.
TAVILY_API_KEY=

# Port for the local API server (server/index.js). The Vite dev server
# proxies /api/* requests to this port automatically.
PORT=3001
